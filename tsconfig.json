{
  "compilerOptions": {
    "target": "ES2022",

    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],

    "module": "ESNext",

    "moduleResolution": "bundler",

    "jsx": "preserve",

    "strict": true,

    "skipLibCheck": true,

    "allowJs": true,

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "isolatedModules": true,

    "incremental": true,

    "noEmit": true,

    "types": [ "@cloudflare/workers-types", "node"]
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],

  "exclude": [
    "node_modules",
    "worker"
  ]
}